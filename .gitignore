# ==============================================================================
# FixLoop - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Secrets, Credentials & Local Files
# ------------------------------------------------------------------------------
AWS details.txt
*details*.txt
*credentials*.txt
*secret*.txt
*.pem
*.key
*.cert
credentials.json
client_secret*.json

# Environment variables (keep example files tracked)
.env
.env.*
!.env.example

# Event / Research reference files & PDFs
neatHack-research-brief.pdf
*.pdf
FIXLOOP_BUILD_PLAN.md
*BUILD_PLAN*.md

# Video Production, Marketing & Internal Scripts
docs/demo-script.md
docs/toolkit-project.json
docs/public-posts.md
*demo-script*
*toolkit-project*
*public-posts*

# ------------------------------------------------------------------------------
# Python & Bytecode
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ------------------------------------------------------------------------------
# Virtual Environments
# ------------------------------------------------------------------------------
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# Distribution & Builds
# ------------------------------------------------------------------------------
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# Testing, Coverage & Linters
# ------------------------------------------------------------------------------
.cache
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
.fixloop/
fixloop-sandbox/
*.log
logs/
tmp/
temp/
*.tmp

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# IDEs & Code Editors
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
claude-code-video-toolkit/
docs/Screenshot *.png
docs/trace-f8dae75f6877187698e6d961e84b1eb7.csv
